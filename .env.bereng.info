# ============================================
# KONFIGURASI UNTUK bereng.info (InfinityFree)
# ============================================
# Edit file ini dengan data database Anda,
# lalu rename menjadi .env dan upload ke hosting

# ============================================
# DATABASE (Isi dengan data dari InfinityFree)
# ============================================

# DB Host (biasanya: sqlXXX.epizy.com - LIHAT DI CONTROL PANEL)
DB_HOST=sqlXXX.epizy.com

# DB Name (format: if0_42138385_namadatabase)
DB_NAME=if0_42138385_skd_cat_bkn

# DB User (sama dengan username database)
DB_USER=if0_42138385_XXXXX

# DB Password (password yang Anda buat saat create database)
DB_PASS=password_anda_di_sini

# Charset (biarkan utf8mb4)
DB_CHARSET=utf8mb4

# ============================================
# ENVIRONMENT & URL
# ============================================

# Mode production (jangan ubah)
APP_ENV=production

# Base URL domain Anda (sudah benar)
BASE_URL=https://bereng.info

# ============================================
# CATATAN PENTING
# ============================================
# 
# 1. GANTI SEMUA XXX dengan data dari InfinityFree Control Panel
# 2. Setelah edit, rename file ini menjadi .env (hapus .bereng.info)
# 3. Upload ke folder htdocs/ di InfinityFree
# 4. Jangan upload file .env ke GitHub (sudah di .gitignore)
#
# ============================================
# CARA DAPATKAN DATA DATABASE:
# ============================================
#
# 1. Login InfinityFree Control Panel
# 2. Klik "MySQL Databases"
# 3. Lihat informasi:
#    - MySQL Hostname = DB_HOST
#    - Database Name = DB_NAME  
#    - Database User = DB_USER
#    - Password = DB_PASS (yang Anda buat)
#
# ============================================
