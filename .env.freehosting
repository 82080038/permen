# Konfigurasi Database untuk Free Hosting (InfinityFree)
# Upload file ini sebagai .env setelah deploy

DB_HOST=localhost
DB_NAME=your_db_name_here
DB_USER=your_db_user_here
DB_PASS=your_db_password_here
DB_CHARSET=utf8mb4

# Environment: development | production
APP_ENV=production

# Base URL aplikasi (ganti dengan domain Anda)
BASE_URL=https://bimbel.freehosting.dev

# Note: Untuk free hosting, biasanya tidak perlu DB_SOCKET
# Jika ada masalah koneksi, coba hapus baris DB_SOCKET dari Database.php
