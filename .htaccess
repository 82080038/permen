# SKD CAT-BKN — Apache Security & Routing

# Disable directory browsing
Options -Indexes

# Protect sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(env|env\.example|sql|md|log|gitignore)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect config and env loader
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

<Files "env_loader.php">
    Order allow,deny
    Deny from all
</Files>

# Protect SQL files in sql/ folder
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sql/.*$ - [F,L]
    RewriteRule ^\.env.*$ - [F,L]
    RewriteRule ^node_modules/.*$ - [F,L]
    RewriteRule ^test-results/.*$ - [F,L]
    
    # API versioning - redirect /api/ to /api/v1/ (optional, for future use)
    # RewriteRule ^api/(?!v1/)(.*)$ api/v1/$1 [R=301,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=()"
    # CSP: allow unsafe-inline for scripts (app uses inline JS extensively), will be refactored in future
    # worker-src allows blob: URLs for dynamic workers (service workers, web workers)
    # media-src allows data: URIs for audio/video elements
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; media-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
</IfModule>

# PHP settings (if allowed by hosting)
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag output_buffering off
    php_value upload_max_filesize 2M
    php_value post_max_size 2M
    php_value max_execution_time 60
</IfModule>

# Enable gzip compression (disabled for debugging)
#<IfModule mod_deflate.c>
#    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
#</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
